# ==============================================================================
# ENVIRONMENT VARIABLES — DEVELOPMENT (LOCAL DOCKER)
# ==============================================================================
# Used for local development against docker-compose.yml.
#
# Every key below is read by apps/scheduler-api's Zod env schema
# (src/config/env.validation.ts) — kept in sync with that schema by hand
# (see .ai/GOTCHAS.md if the two ever drift).
#
# This is a single-service repo (see .ai/plans/init-source.plan.md §0) — there is one database,
# one app port, and no message broker. If a variable here looks like it is
# missing a sibling (a second DB URL, a Kafka client id), that is intentional:
# T3/T4 infrastructure is deferred, not wired — see docs/03_system_architecture_diagrams.md
# § Deferred scope.

# --- NODE ENV ---
NODE_ENV=development

# --- DATABASE (POSTGRESQL, LOCAL DOCKER) ---
DB_HOST=localhost
DB_PORT=15433
DB_USER=root
DB_PASSWORD=rootpassword
SCHEDULER_DB_NAME=scheduler_db

# Idempotency records live in the same database — see docs/adr and
# .ai/plans/init-source.plan.md §8.3 for why there is no REDIS_* block here.
SCHEDULER_DATABASE_URL="postgresql://root:rootpassword@localhost:15433/scheduler_db?schema=public"

# --- APP ---
PORT=4002

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- LOGGING ---
LOG_LEVEL=info

# --- BUSINESS HOURS (scheduler domain) ---
# The dealership's bookable day. Deliberately configuration and not a
# DealershipOpeningHours table — see docs/adr/0003-availability-and-selection-policy.md
# §2.3. Consequence: ONE schedule applies to every dealership.
#
# BUSINESS_HOURS_END is the latest time a service may *end*, so a 90-minute
# service is offered no later than 16:30 with the defaults below.
# SLOT_GRANULARITY_MINUTES controls where a service may START; duration always
# comes from ServiceType.durationMinutes.
BUSINESS_HOURS_START=08:00
BUSINESS_HOURS_END=18:00
BUSINESS_TIMEZONE=UTC
SLOT_GRANULARITY_MINUTES=30

# --- OBSERVABILITY (Prometheus / Grafana) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
