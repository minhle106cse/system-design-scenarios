# Overrides only. There is no .env to CREATE to get running — apps/web/.env ships committed with
# this exact value, so `npm install && npm run dev` needs zero setup. Copy this file to .env.local
# and override NEXT_PUBLIC_API_BASE_URL only if apps/scheduler-api runs somewhere other than
# localhost:4102 (its own PORT, ../../.env).
NEXT_PUBLIC_API_BASE_URL="http://localhost:4102/api/v1"
