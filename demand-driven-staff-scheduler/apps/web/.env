# Committed deliberately (not a secret — a localhost URL) so `npm install && npm run dev` works
# with zero configuration, same reasoning this file used to give for DATABASE_URL before the
# backend-architecture-reversal moved persistence to apps/scheduler-api (Phase E). apps/web now
# owns no database — every read/write goes through this URL instead (src/lib/api-client.ts).
# Matches apps/scheduler-api's PORT=4102 and CORS_ALLOWED_ORIGINS=http://localhost:3000 (../../.env).
NEXT_PUBLIC_API_BASE_URL="http://localhost:4102/api/v1"
