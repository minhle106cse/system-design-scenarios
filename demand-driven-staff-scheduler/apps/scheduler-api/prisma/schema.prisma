// Data model — docs/04_data_model.md. PostgreSQL via Prisma, owned entirely by apps/scheduler-api
// (backend-architecture-reversal.plan.md §5 — moved here from the earlier apps/web/SQLite draft).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("SCHEDULER_DATABASE_URL")
}

// Soft-delete (`deletedAt`) on Schedule/StaffMember/Shift only — the three "add/edit/remove" CRUD
// entities (brief §2.1/2.2/2.4). DemandCell/Assignment/ScheduleRun are replaced wholesale
// (assumptions 10/11), never individually soft-deleted — see PrismaService's SOFT_DELETE_MODELS
// comment for the full reasoning.

model Schedule {
  id                       String    @id @default(uuid())
  name                     String
  transactionsPerStaffHour Float     @default(18) @map("transactions_per_staff_hour")
  minStaffWhenOpen         Int       @default(1) @map("min_staff_when_open")
  maxStaffPerHour          Int?      @map("max_staff_per_hour")
  minUtilisationTarget     Float     @default(0.6) @map("min_utilisation_target")
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  deletedAt                DateTime? @map("deleted_at")

  // Roster-freshness tracking (staleness.ts on the web side). NOT auto-managed by `@updatedAt` —
  // that field already tracks writes to the Schedule row itself (the four parameters), so it
  // covers "N changed" for free. These four track writes to the *related* input tables instead —
  // staff/shift/demand/role CRUD never touches the Schedule row, so without an explicit touch here
  // a manager could add staff, re-import demand, or edit a shift and the roster would still read
  // CURRENT. Each repository that mutates the corresponding table stamps `now()` here in the same
  // transaction (see `touchSchedule` in infrastructure/repositories). Null until first touched —
  // compared against `ScheduleRun.generatedAt` with `null` treated as "never changed," never as an
  // epoch date, so a schedule with no staff edits yet doesn't read as permanently stale.
  staffUpdatedAt           DateTime? @map("staff_updated_at")
  shiftsUpdatedAt          DateTime? @map("shifts_updated_at")
  demandUpdatedAt          DateTime? @map("demand_updated_at")
  rolesUpdatedAt           DateTime? @map("roles_updated_at")

  staff       StaffMember[]
  demandCells DemandCell[]
  shifts      Shift[]
  assignments Assignment[]
  runs        ScheduleRun[]
  roles       Role[]

  @@map("schedules")
}

model StaffMember {
  id             String    @id @default(uuid())
  scheduleId     String    @map("schedule_id")
  name           String
  maxWeeklyHours Float     @map("max_weekly_hours")
  deletedAt      DateTime? @map("deleted_at")

  schedule       Schedule              @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  assignments    Assignment[]
  unavailability StaffUnavailability[]
  roles          StaffRole[]

  @@map("staff_members")
}

// No `deletedAt` — a config row replaced wholesale (add/remove, never edited), same class as
// DemandCell/Assignment, not the "add/edit/remove" CRUD entities that get soft-deleted above
// (stretch-goals plan §1b). PrismaService's SOFT_DELETE_MODELS array is deliberately left alone.
model StaffUnavailability {
  id          String @id @default(uuid())
  staffId     String @map("staff_id")
  dayOfWeek   Int    @map("day_of_week") // 1 = Monday .. 7 = Sunday
  startMinute Int    @map("start_minute")
  endMinute   Int    @map("end_minute") // > startMinute, same rule as Shift (assumption 3)

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@map("staff_unavailability")
}

model DemandCell {
  id           String @id @default(uuid())
  scheduleId   String @map("schedule_id")
  dayOfWeek    Int    @map("day_of_week") // 1 = Monday .. 7 = Sunday
  hour         Int // 0-23
  transactions Int

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, dayOfWeek, hour]) // re-import upserts (assumption 10), never appends
  @@map("demand_cells")
}

model Shift {
  id          String    @id @default(uuid())
  scheduleId  String    @map("schedule_id")
  label       String
  startMinute Int       @map("start_minute") // minutes from midnight
  endMinute   Int       @map("end_minute") // endMinute > startMinute (assumption 3, no overnight shifts)
  deletedAt   DateTime? @map("deleted_at")

  schedule          Schedule               @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  assignments       Assignment[]
  roleRequirements  ShiftRoleRequirement[]

  @@map("shifts")
}

// Roles/skills (brief §8 stretch) — many-to-many: a person can hold more than one role (D2,
// stretch-goals plan §2b). uuid PK + `@@unique` throughout, matching DemandCell/Assignment's
// shape — not a composite PK, so the repo's one-shape-for-every-model convention holds.
model Role {
  id         String @id @default(uuid())
  scheduleId String @map("schedule_id")
  name       String

  schedule          Schedule               @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  staff             StaffRole[]
  shiftRequirements ShiftRoleRequirement[]

  @@unique([scheduleId, name])
  @@map("roles")
}

model StaffRole {
  id      String @id @default(uuid())
  staffId String @map("staff_id")
  roleId  String @map("role_id")

  staff StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  role  Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([staffId, roleId])
  @@map("staff_roles")
}

model ShiftRoleRequirement {
  id       String @id @default(uuid())
  shiftId  String @map("shift_id")
  roleId   String @map("role_id")
  minCount Int    @map("min_count")

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  role  Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([shiftId, roleId])
  @@map("shift_role_requirements")
}

model Assignment {
  id         String @id @default(uuid())
  scheduleId String @map("schedule_id")
  staffId    String @map("staff_id")
  shiftId    String @map("shift_id")
  dayOfWeek  Int    @map("day_of_week")
  source     String @default("AUTO") // "AUTO" | "MANUAL"

  schedule Schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  staff    StaffMember @relation(fields: [staffId], references: [id], onDelete: Cascade)
  shift    Shift       @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@unique([staffId, shiftId, dayOfWeek]) // mirrors FeasibilityGate H3
  @@map("assignments")
}

model ScheduleRun {
  id          String   @id @default(uuid())
  scheduleId  String   @map("schedule_id")
  generatedAt DateTime @default(now()) @map("generated_at")
  parameters  Json // the parameters that produced this run
  diagnostics Json // init plan §7.6

  schedule Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("schedule_runs")
}
