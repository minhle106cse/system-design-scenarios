{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint:fix": { "cache": false },
    "format": { "cache": false },
    "format:check": {},
    "test": {
      "dependsOn": ["build"]
    },
    "test:cov": {
      "dependsOn": ["build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["build"]
    },
    "db:push": { "cache": false },
    "db:format": { "cache": false },
    "db:migrate": { "cache": false },
    "db:deploy": { "cache": false },
    "db:seed": {
      "cache": false,
      "dependsOn": ["db:migrate"]
    },
    "db:generate": { "cache": false },
    "db:studio": {
      "cache": false,
      "persistent": true
    }
  }
}
