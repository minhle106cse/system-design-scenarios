# ==============================================================================
# ENVIRONMENT VARIABLES — DEVELOPMENT (LOCAL DOCKER)
# ==============================================================================
# Used for local development against docker-compose.yml. Every key below is read by
# apps/scheduler-api's Zod env schema (src/config/env.validation.ts) — kept in sync by hand.
#
# Single-service backend: one database, one app port, no message broker
# (backend-architecture-reversal.plan.md §6 — Prometheus/Grafana and an idempotency store are
# deferred, not wired).

# --- NODE ENV ---
NODE_ENV=development

# --- DATABASE (POSTGRESQL, LOCAL DOCKER) ---
DB_HOST=localhost
DB_PORT=15434
DB_USER=root
DB_PASSWORD=rootpassword
SCHEDULER_DB_NAME=staff_scheduler_db

SCHEDULER_DATABASE_URL="postgresql://root:rootpassword@localhost:15434/staff_scheduler_db?schema=public"

# --- APP ---
PORT=4102
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- LOGGING ---
LOG_LEVEL=info
